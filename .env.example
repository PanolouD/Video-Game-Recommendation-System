# ==================================================
# Database
# Replace the username, password, and database name.
# ==================================================
DATABASE_URL=postgresql+psycopg://thesis_user:CHANGE_ME@localhost:5432/video_game_recommendations

# ==================================================
# Authentication
# Generate a unique random SECRET_KEY for each setup.
# ==================================================
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================================================
# Password reset
# Token lifetime in minutes.
# ==================================================
RESET_TOKEN_EXPIRE_MINUTES=60

# ==================================================
# Profile-picture uploads
# Maximum upload size in bytes: 5242880 = 5 MiB.
# ==================================================
MAX_UPLOAD_SIZE_BYTES=5242880

# ==================================================
# Frontend
# Used for frontend-related links, such as password reset.
# ==================================================
FRONTEND_URL=http://localhost:3000

# ==================================================
# IGDB / Twitch
# Use your own Twitch application credentials.
# ==================================================
IGDB_CLIENT_ID=REPLACE_WITH_YOUR_TWITCH_CLIENT_ID
IGDB_CLIENT_SECRET=REPLACE_WITH_YOUR_TWITCH_CLIENT_SECRET

# ==================================================
# SMTP email
# Replace these values with your email provider settings.
# These placeholders will not deliver emails.
# ==================================================
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_YOUR_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_YOUR_SMTP_PASSWORD
MAIL_FROM=noreply@example.com
MAIL_USE_TLS=true